# --- Explicitly ignored ---
__pycache__/
*.pyc
.DS_Store
logs/
.claude/

# --- Standard Python / environment hygiene ---
*.pyo
.venv/
venv/
env/
.env
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# --- Editor / IDE junk ---
.vscode/
.idea/

# NOTE: source code, data/, output/, README.md, and FRAMEWORK_MAPPING.md are
# intentionally NOT ignored - this repo commits its generated data and
# results so they're visible without re-running the pipeline.
